# Copy to .env (for scripts/seed.ts) and to the Next.js app's .env.local
# (for the NEXT_PUBLIC_ vars) once the Supabase project exists.
# Find these under Project Settings -> API in the Supabase dashboard.

# Used by scripts/seed.ts (Node, service role — bypasses RLS to seed data)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Used by the Next.js app / lib/supabaseClient.ts (browser, anon key)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional: run `npm run seed` with SEED_DEMO_ACTIVITY=true to pre-seed a
# few checkins/going rows so the map has visible buzz before anyone taps
# check-in live.
SEED_DEMO_ACTIVITY=false

# Live event source — replaces Eventbrite (public search API is dead).
# Powers scripts/fetchTicketmasterEvents.ts. Safe to leave blank; the
# hand-curated events in scripts/seedData/events.ts are the permanent
# golden-path floor regardless.
TICKETMASTER_API_KEY=

# Powers scripts/generateBlurbs.ts (suburb "known for" one-liners).
OPENAI_API_KEY=

# Not currently used by any script — safe to leave blank.
EVENTBRITE_API_KEY=
ANTHROPIC_API_KEY=
